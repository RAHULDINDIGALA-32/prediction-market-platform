model Market {
  id           String   @id
  contractAddress String? @unique
  status       MarketStatus

  qYes         Decimal
  qNo          Decimal
  b            Decimal

  collateral   Decimal

  version      Int      
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades       Trade[]
}

model TraderNonce {
  id        String   @id @default(uuid())
  trader    String
  marketId  String
  lastNonce BigInt  @default(0)
  updatedAt DateTime @updatedAt

  market    Market   @relation(fields: [marketId], references: [id])

  @@unique([trader, marketId])
  @@index([marketId])
}

model SignedQuote {
  id         String   @id @default(uuid())
  trader     String
  marketId   String
  quoteHash  String   @unique
  signature  String
  amount     Decimal
  cost       Decimal
  nonce      BigInt
  isSell     Boolean  @default(false)
  minAmountOut Decimal?
  minReturn   Decimal?
  status     SignedQuoteStatus @default(PENDING)
  createdAt  DateTime @default(now())

  market     Market   @relation(fields: [marketId], references: [id])

  @@index([marketId])
}

enum SignedQuoteStatus {
  PENDING
  COMMITTED
  CANCELLED
}
