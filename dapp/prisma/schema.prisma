generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_PUBLIC_DATABASE_URL")
  directUrl = env("NEXT_PUBLIC_DIRECT_URL")
}

model Market {
  id              String        @id
  contractAddress String?       @unique
  status          MarketStatus
  qYes            Decimal
  qNo             Decimal
  lmsrB           Decimal     // Creator-specified LMSR liquidity parameter
  collateral      Decimal
  version         Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Market metadata fields
  metadataHash    String?       @unique
  ipfsCid         String?
  title           String?
  description     String?
  category        String?
  resolutionSource String?
  endTime         BigInt?       // Unix timestamp from contract
  
  // Creator and subsidy tracking
  creator         String
  subsidyAmount   Decimal?      // Creator's LMSR subsidy deposit (b * ln(2))
  
  signedQuotes    SignedQuote[]
  trades          Trade[]
  traderNonces    TraderNonce[]
  oracleEvents    OracleEvent[]
  redemptionEvents RedemptionEvent[] @relation(name: "RedemptionEvents")
  settlementEvents SettlementEvent[] @relation(name: "SettlementEvents")
}

model OracleEvent {
  id                String      @id @default(uuid())
  marketId          String
  market            Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  
  // Oracle participants
  proposer          String
  disputer          String?
  
  // Proposed and finalized outcomes
  proposed          Outcome
  finalized         Outcome?
  disputed          Boolean     @default(false)
  
  // Timestamps for state transitions
  disputedAt        DateTime?
  finalizedAt       DateTime?   // NULL until finalized, then explicitly set
  createdAt         DateTime    @default(now())
  
  proposalTxHash    String?     @unique
  proposalBlock     BigInt?
  disputeTxHash     String?     @unique
  disputeBlock      BigInt?
  resolutionTxHash  String?     @unique
  resolutionBlock   BigInt?

  @@index([marketId])
  @@index([proposer])
  @@index([finalized])
}

model TraderNonce {
  id        String   @id @default(uuid())
  trader    String
  marketId  String
  lastNonce BigInt   @default(0)
  updatedAt DateTime @updatedAt
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([trader, marketId])
  @@index([marketId])
}

model SignedQuote {
  id            String            @id @default(uuid())
  trader        String
  marketId      String
  quoteHash     String            @unique
  signature     String
  amount        Decimal
  cost          Decimal
  nonce         BigInt
  isSell        Boolean           @default(false)
  marketVersion Int
  minAmountOut  Decimal?
  minReturn     Decimal?
  status        SignedQuoteStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  market        Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}

model Trade {
  id              String    @id @default(uuid())
  marketId        String
  side            TradeSide
  amount          Decimal
  cost            Decimal
  trader          String
  marketVer       Int
  
  // Transaction info for audit trail
  transactionHash String    @unique
  blockNumber     BigInt
  
  createdAt       DateTime  @default(now())
  market          Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([trader])
  @@index([transactionHash])
}

// Authorization models for syncing from blockchain
model WhitelistedCreator {
  id           String   @id @default(uuid())
  address      String   @unique @db.VarChar(42)
  isWhitelisted Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([address])
}

model AuthorizedSigner {
  id        String   @id @default(uuid())
  address   String   @unique @db.VarChar(42)
  privateKey String  @unique @db.VarChar(255) // encrypted
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
}

model OracleResolver {
  id        String   @id @default(uuid())
  address   String   @unique @db.VarChar(42)
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
}

model SyncLog {
  id               String   @id @default(uuid())
  service          String   @unique // "marketFactory", "quoteVerifier", "oracleAdapter"
  lastBlockScanned BigInt   @default(0)
  lastSyncedAt     DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([service])
}


model RedemptionEvent {
  id              String      @id @default(uuid())
  marketId        String
  market          Market      @relation(name: "RedemptionEvents", fields: [marketId], references: [id], onDelete: Cascade)
  
  user            String      // User who redeemed tokens
  amount          BigInt      // Tokens redeemed (in wei)
  
  // Transaction info for audit trail
  transactionHash String      @unique
  blockNumber     BigInt
  
  createdAt       DateTime    @default(now())

  @@index([marketId])
  @@index([user])
  @@index([transactionHash])
}


model SettlementEvent {
  id              String      @id @default(uuid())
  marketId        String
  market          Market      @relation(name: "SettlementEvents", fields: [marketId], references: [id], onDelete: Cascade)
  
  creator         String      // Creator address
  amountWithdrawn BigInt      // Collateral withdrawn (in wei)
  
  // Transaction info for audit trail
  transactionHash String      @unique
  blockNumber     BigInt
  
  createdAt       DateTime    @default(now())

  @@index([marketId])
  @@index([creator])
  @@index([transactionHash])
}


enum MarketStatus {
  OPEN
  CLOSED     
  RESOLVED
  SETTLED
}

enum TradeSide {
  YES
  NO
}

enum Outcome {
  YES
  NO
}

enum SignedQuoteStatus {
  PENDING
  COMMITTED
  CANCELLED
}

enum CreatorRole {
  ADMIN
  EDITOR
}

