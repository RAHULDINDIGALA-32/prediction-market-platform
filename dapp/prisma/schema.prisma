generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Market {
  id              String        @id
  contractAddress String?       @unique
  status          MarketStatus
  qYes            Decimal
  qNo             Decimal
  lmsrB           Decimal     // Creator-specified LMSR liquidity parameter
  collateral      Decimal
  version         Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Market metadata fields
  metadataHash    String?       @unique
  ipfsCid         String?
  title           String?
  description     String?
  category        String?
  resolutionSource String?
  endTime         BigInt?       // Unix timestamp from contract
  
  // Creator and subsidy tracking
  creator         String
  subsidyAmount   Decimal?      // Creator's LMSR subsidy deposit (b * ln(2))
  
  signedQuotes    SignedQuote[]
  trades          Trade[]
  traderNonces    TraderNonce[]
  oracleEvents    OracleEvent[]
}

model OracleEvent {
  id           String      @id @default(uuid())
  marketId     String
  market       Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  proposer     String
  disputer     String?
  proposed     Outcome
  finalized    Outcome?
  disputedAt   DateTime?
  finalizedAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([marketId])
  @@index([proposer])
}

model TraderNonce {
  id        String   @id @default(uuid())
  trader    String
  marketId  String
  lastNonce BigInt   @default(0)
  updatedAt DateTime @updatedAt
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([trader, marketId])
  @@index([marketId])
}

model SignedQuote {
  id            String            @id @default(uuid())
  trader        String
  marketId      String
  quoteHash     String            @unique
  signature     String
  amount        Decimal
  cost          Decimal
  nonce         BigInt
  isSell        Boolean           @default(false)
  marketVersion Int
  minAmountOut  Decimal?
  minReturn     Decimal?
  status        SignedQuoteStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  market        Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}

model Trade {
  id        String    @id @default(uuid())
  marketId  String
  side      TradeSide
  amount    Decimal
  cost      Decimal
  trader    String
  marketVer Int
  createdAt DateTime  @default(now())
  market    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}

// Authorization models for syncing from blockchain
model WhitelistedCreator {
  id           String   @id @default(uuid())
  address      String   @unique @db.VarChar(42)
  isWhitelisted Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([address])
}

model AuthorizedSigner {
  id        String   @id @default(uuid())
  address   String   @unique @db.VarChar(42)
  privateKey String  @unique @db.VarChar(255) // encrypted
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
}

model OracleResolver {
  id        String   @id @default(uuid())
  address   String   @unique @db.VarChar(42)
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
}

model SyncLog {
  id               String   @id @default(uuid())
  service          String   @unique // "marketFactory", "quoteVerifier", "oracleAdapter"
  lastBlockScanned BigInt   @default(0)
  lastSyncedAt     DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([service])
}


enum MarketStatus {
  OPEN
  CLOSED     
  RESOLVED
  SETTLED
}

enum TradeSide {
  YES
  NO
}

enum Outcome {
  YES
  NO
}

enum SignedQuoteStatus {
  PENDING
  COMMITTED
  CANCELLED
}

enum CreatorRole {
  ADMIN
  EDITOR
}

